# Service wiring for the local stack. Copy to run/services.env and adjust.
#
#   cp run/services.env.example run/services.env
#
# These are LOCAL endpoints only. The stack's datastore credentials are dummy
# values and live in setup/local.mjs (dynamodb-local ignores them; MySQL is
# root/local inside the compose network). Nothing here should ever be a real
# secret — run/services.env is gitignored so it stays that way if you add one.

# ── the services this stack drives ─────────────────────────────────────────
# These are the production Predictor services, run locally. They are separate
# repos and are NOT vendored here — see "What you need beyond this repo" in the
# README. Ports must match what you start them on.
TRADING_API=http://localhost:8080
MATCHER_URL=http://localhost:7001
DIST_URL=http://localhost:7002
WALLET_STUB=http://localhost:3000
DASHBOARD_API=http://localhost:4000
HEDGING_SERVICE=http://localhost:8790

# ── local infrastructure (docker compose up -d) ────────────────────────────
DYNAMO_ENDPOINT=http://localhost:8000
SQS_ENDPOINT=http://localhost:9324
AWS_REGION=ap-south-1
BRIDGE_QUEUES=matching-engine.fifo,sell-order.fifo

# ── market configuration ───────────────────────────────────────────────────
ORACLE_SYMBOL=BTCUSDT
BINANCE_WS_BASE=wss://stream.binance.com:9443
PRIMARY_TENOR_TAG=5m
TENOR_MIN=5
STRIKE_ROUND_USD=10

# ── house market maker ─────────────────────────────────────────────────────
# Local-only API key for the MMP's own calls — not a credential for anything
# external. Change it if you like; it just has to match across processes.
MMP_API_KEY=localkey
MMP_QUOTER_LOOP_MS=400
MMP_TRIGGER_MOVE_USD=5
