# Env for the UNMODIFIED production Predictor services when run against this
# local docker stack. Their configs are entirely env-driven (config/development.js
# in trading-api, EnvConfig in the distribution engine), so pointing them local is
# purely a matter of these vars — no repo changes.
#
#   cp run/services.env.example run/services.env
#   set -a; . run/services.env; set +a     # then start the service
#
# NOT NEEDED for the default path. `./start.sh` uses standalone/services.mjs,
# which implements the same order-path endpoints and needs none of this. Use this
# file only if you have the production services and want to run against them.
#
# Every value here is a local dummy — the same credentials setup/local.mjs
# already contains. Nothing in this file is a secret.

# --- MySQL (predictor) ---
MYSQL_PREDICTOR_HOST=127.0.0.1
MYSQL_PREDICTOR_USERNAME=root
MYSQL_PREDICTOR_PASSWORD=local
MYSQL_PREDICTOR_DB_NAME=predictor

# --- Redis (single local instance stands in for main/mmp/read replicas) ---
REDIS_HOST=127.0.0.1
REDIS_HOST_MMP=127.0.0.1
REDIS_READ_HOST=127.0.0.1

# --- AWS-ish (dynamodb-local + elasticmq); creds are dummies, endpoints are
# forced by run/aws-local.cjs for the SDK-v2 services ---
REGION=ap-south-1
AWS_REGION=ap-south-1
ACCOUNT_ID=000000000000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMO_ENDPOINT=http://localhost:8000
SQS_ENDPOINT=http://localhost:9324

# --- Queue names: match localstack/elasticmq.conf exactly ---
MATCHING_SQS_NAME=matching-engine.fifo
SELL_ORDER_SQS_NAME=sell-order.fifo
CANCEL_ORDER_SQS_NAME=cancel-order.fifo

# --- House market-maker identity (matches setup/local.mjs MMP_USER_ID) ---
# src/utils/CheckMmpUser.js gates the placeBid/orderbook routes on:
#   api_key == MMP_API_KEY && (SKIP_MMP_AUTH || MMP_PRIVATE_IP.includes(req.ip))
# Over loopback req.ip arrives as `::1` / `::ffff:127.0.0.1` (IPv6-mapped), so a
# plain 127.0.0.1 list never matches. SKIP_MMP_AUTH is their own dev escape
# hatch; the widened IP list is belt-and-braces if it's ever unset.
MMP_USER_ID=999999999
MMP_API_KEY=localkey
# Must stay QUOTED: the value contains spaces (their code does .split(" ")), and
# CheckMmpUser.js calls .split() BEFORE testing SKIP_MMP_AUTH — so if this var is
# unset the helper throws and every placeBid falls through to the JWT path
# ("Bad token"). Source this file with `set -a; . run/services.env; set +a`,
# never via `xargs`, which would split the value into stray argv tokens.
MMP_PRIVATE_IP="127.0.0.1 ::1 ::ffff:127.0.0.1"
SKIP_MMP_AUTH=1

# --- Wallet stub (drivers/wallet-stub) ---
WALLET_SERVICE_URL=http://localhost:3000
API_SECRET=localsecret
